# Copy to .env (run.sh does this for you on first run). NEVER commit .env.
# Everything below is local configuration; nothing is sent to any vendor.

# --- Storage -----------------------------------------------------------
# Where originals, versioned outputs, the managed PostgreSQL cluster and backups live.
DATA_DIR=./data
BACKUP_DIR=./backups
# Days until a file is purged automatically. 0 = never expire.
FILE_TTL_DAYS=30
MAX_UPLOAD_MB=200

# --- PostgreSQL --------------------------------------------------------
# Leave DATABASE_URL empty to use the project-managed local cluster
# (stored in DATA_DIR/postgres, listening on 127.0.0.1 only).
DATABASE_URL=
PG_PORT=54329
# run.sh replaces this placeholder with a random value on first run.
PG_PASSWORD=change-me

# --- Servers -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
# Base URL placed in signing links. Change it only if signers reach this machine
# via a LAN address or a tunnel you operate yourself.
PUBLIC_BASE_URL=http://localhost:3000
# Allow the management UI/API to be used from non-localhost hosts (not recommended).
ALLOW_REMOTE_ADMIN=false

# --- Secrets -----------------------------------------------------------
# Used to HMAC signer link tokens. run.sh generates a random value on first run.
SECRET_KEY=change-me

# --- Signature invitations (optional) ------------------------------------
# Leave SMTP_HOST empty to skip email: invitations then produce a link you share yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SIGN_LINK_TTL_DAYS=14

# --- Tools ---------------------------------------------------------------
OFFICE_TIMEOUT_SECONDS=120
OCR_TIMEOUT_SECONDS=600
OCR_LANGUAGES=eng
